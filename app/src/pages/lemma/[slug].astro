---
import fs from 'node:fs';
import path from 'node:path';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import '@shared/styles/global.css';

export function getStaticPaths() {
  const indexFile = path.resolve('public/data/lemmata/_index.json');
  if (fs.existsSync(indexFile)) {
    const data = JSON.parse(fs.readFileSync(indexFile, 'utf-8'));
    // Select top 25 most frequent lemmata to pre-render statically
    const sorted = Object.entries(data as Record<string, any>)
      .sort((a, b) => (b[1].count || 0) - (a[1].count || 0))
      .slice(0, 25);
    const slugs = sorted
      .map(([s]) => s.replace(/[%/\\]+/g, '').trim())
      .filter(Boolean);
    const uniqueSlugs = Array.from(new Set(slugs));
    return uniqueSlugs.map(slug => ({
      params: { slug }
    }));
  }
  return [
    { params: { slug: 'λογοσ' } },
    { params: { slug: 'θεοσ' } }
  ];
}

const { slug } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

let lemmaHead = slug;
let count = 0;

const indexFile = path.resolve('public/data/lemmata/_index.json');
if (fs.existsSync(indexFile)) {
  const data = JSON.parse(fs.readFileSync(indexFile, 'utf-8'));
  const entry = data[slug || ''];
  if (entry) {
    lemmaHead = entry.lemma || slug;
    count = entry.count || 0;
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lemma: {lemmaHead} — Josephus Concordance</title>
    <ThemeInit />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&family=EB+Garamond:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />
  </head>
  <body class="lemma-body">
    <div class="lemma-container">
      <header class="lemma-header">
        <div class="header-nav">
          <a href={base || '/'} class="back-link">← Return to Josephus Reader</a>
          <ThemeToggle />
        </div>
        <h1 class="lemma-title">{lemmaHead}</h1>
        <p class="lemma-sub">Concordance &amp; occurrence summary across Flavius Josephus</p>
      </header>

      <div class="lemma-body">
        <div class="lemma-card">
          <h2>Lemma: <code>{slug}</code></h2>
          <p>This lemma appears {count > 0 ? `${count} times` : 'throughout'} Flavius Josephus' works (*Antiquities*, *War*, *Life*, *Apion*).</p>
          <a href={base || '/'} class="btn primary-btn">Return to Reader Library</a>
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  .lemma-body {
    background-color: var(--page-bg, #eceee7);
    color: var(--text, #171a1c);
    font-family: var(--font-ui, system-ui, sans-serif);
    margin: 0;
    padding: 0;
    min-height: 100vh;
  }
  .lemma-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .header-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .back-link {
    color: var(--accent, #1f6f7a);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .back-link:hover {
    text-decoration: underline;
  }
  .lemma-title {
    font-family: var(--font-greek, "Cardo", serif);
    font-size: 3rem;
    color: var(--accent, #1f6f7a);
    margin: 0 0 0.5rem 0;
  }
  .lemma-sub {
    color: var(--text-mid, #545b5c);
    font-size: 1.05rem;
  }
  .lemma-card {
    background-color: var(--col-bg, #f5f6f2);
    border: 1px solid var(--border, #d4d8d3);
    border-radius: 8px;
    padding: 2rem;
  }
  .btn {
    display: inline-block;
    background-color: var(--accent, #1f6f7a);
    color: #ffffff;
    padding: 0.6rem 1.25rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    margin-top: 1rem;
  }
</style>
