{
  "name": "josephus-reader",
  "private": true,
  "version": "0.1.15",
  "repository": "https://github.com/cbop-dev/josephus-reader",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "python3 -m pipeline.josephus_pipeline all && npm --prefix app run build",
    "build:app": "npm --prefix app run build",
    "preview": "npm --prefix app run preview",
    "check": "npm --prefix app run astro check",
    "pipeline": "python3 -m pipeline.josephus_pipeline all",
    "deploy:vps": "./scripts/deploy_vps.sh",
    "deploy:vps:quick": "./scripts/deploy_vps.sh --no-build"
  }
}